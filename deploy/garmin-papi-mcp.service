[Unit]
Description=garmin-papi-mcp (read-only MCP server for the Garmin Connect Personal API, with an OAuth 2.1 login form)
Documentation=https://github.com/zigmund/garmin-papi-mcp
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/local/bin/garmin-papi-mcp -config /etc/garmin-papi-mcp/config.yaml
# SIGHUP is handled by the binary and does not stop it (reloads the TLS certificate when tls.* is set).
# It reloads nothing else: the config and the token keys are read only at
# start, so use `systemctl restart` after changing them.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2s
# SIGTERM starts a graceful shutdown: in-flight requests get 20 s to finish (one
# Garmin request at the default garmin.timeout); tool calls still waiting on
# Garmin are then cancelled and answered with a tool error, and 5 s later the
# remaining connections are closed. 35 s leaves headroom over those 25 s before
# systemd sends SIGKILL; keep it above 25 s.
TimeoutStopSec=35s

# Run as a transient unprivileged user; no state is written to disk.
DynamicUser=yes

# Token encryption keys. The config should NOT contain `token_keys`: with
# DynamicUser= the config file is typically root-owned and world-readable (see
# the README). Instead keep the keys in a
# root-only file and let systemd hand a private copy to the service:
#   secrets.token_keys_file: /run/credentials/garmin-papi-mcp.service/keys
# (the config does not expand environment variables, so $CREDENTIALS_DIRECTORY
# cannot be used there; use the absolute path above, the name after the colon
# below is the file name inside the credentials directory).
# Create the source file with: install -m 0600 -o root -g root /dev/null /etc/garmin-papi-mcp/keys
LoadCredential=keys:/etc/garmin-papi-mcp/keys

# Built-in TLS (tls.cert_file/tls.key_file) with a Let's Encrypt certificate:
# /etc/letsencrypt/{live,archive} are 0700 root and privkey*.pem 0600 by
# default, so the dynamic user cannot read them. Pick one; the steps and a
# certbot deploy hook for each are in
# docs/configuration.md#lets-encrypt-with-built-in-tls
# a) Read in place, with hot reload: groupadd --system tls-certs; give it g+rx
#    on live/, archive/ and the certificate's dirs and 0640 on
#    archive/<name>/privkey*.pem (the deploy hook re-applies this after each
#    renewal, then reloads the service), and add in a drop-in:
#      SupplementaryGroups=tls-certs
# b) Private copy (no hot reload; the deploy hook restarts the service):
#      LoadCredential=fullchain.pem:/etc/letsencrypt/live/mcp.example.com/fullchain.pem
#      LoadCredential=privkey.pem:/etc/letsencrypt/live/mcp.example.com/privkey.pem
#    with tls.cert_file/key_file under /run/credentials/garmin-papi-mcp.service/.
# Binding a port below 1024 additionally needs AmbientCapabilities=CAP_NET_BIND_SERVICE
# (and CapabilityBoundingSet=CAP_NET_BIND_SERVICE); prefer a high port.

# --- Hardening ---
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# Outbound HTTPS to Garmin and inbound TCP only. Add AF_UNIX only if you
# need syslog/journald sockets from inside the process (stderr is enough here).
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Go binaries do not need W+X mappings.
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
